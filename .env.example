NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_PRICE_ID_USD=
STRIPE_PRO_PRICE_ID_INR=
STRIPE_PRO_PRICE_ID_DEFAULT=
STRIPE_WEBHOOK_SECRET=
APP_BASE_URL=http://localhost:9002

GEMINI_API_KEY=
OPENROUTER_API_KEY=
CLARIFT_OPENROUTER_API_KEY=
CLARIFT_TOGETHER_API_KEY=

# Server-only owner/admin bootstrap. Prefer UIDs once known; emails are useful for first owner bootstrap.
OWNER_EMAILS=
OWNER_UIDS=
ADMIN_EMAILS=
SUPPORT_EMAILS=

# Emergency feature flags. Production checks require explicit true/false values.
ENABLE_ADMIN_CENTER=false
ENABLE_DISCOUNT_ADMIN=false
ENABLE_FILE_CONVERSION=true
ENABLE_STRIPE_CHECKOUT=true
ENABLE_PROMOTION_CODES=false
ENABLE_SUPPORT_ACCESS_REQUESTS=false
ENABLE_MANAGED_OPENROUTER=false
ENABLE_MANAGED_INFERENCE=true
ENABLE_FREE_MANAGED_INFERENCE=false
ENABLE_LOCAL_INFERENCE_FALLBACK=false
ENABLE_BYOK=false
ENABLE_RAZORPAY_BILLING=false
ENABLE_EXTENSION_ACCOUNT_LINKING=true
ENABLE_PUBLIC_API=false
ENABLE_PROJECT_SHARING=false
ENABLE_USAGE_ANALYTICS=false

# Server-only HMAC/signing secrets. Store these in Secret Manager in production.
PROMO_CODE_PEPPER=
CLARIFT_API_KEY_PEPPER=
CLARIFT_API_TOKEN_PEPPER=
CLARIFT_BYOK_ENCRYPTION_KEY=
CRON_SECRET=
PUBLIC_API_RATE_LIMIT_PER_MINUTE=30

# Razorpay stays disabled until KYC, product policy, catalog, and test-mode gates are complete.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_OLD_SECRET=
RAZORPAY_CATALOG_JSON=[]

# Managed-inference wallet and distributed protection.
CLARIFT_TRIAL_CREDITS=10
CLARIFT_TASK_COSTS_JSON={"quick_refine":1,"guided_fix":2,"full_council":5,"evaluate":1,"apply_fix":2,"convert_document":0}
CLARIFT_USER_RPM=20
CLARIFT_TENANT_RPM=40
CLARIFT_TASK_CONCURRENCY=3
CLARIFT_FULL_COUNCIL_CONCURRENCY=1
CLARIFT_PROVIDER_TIMEOUT_MS=90000
CLARIFT_PROVIDER_RETRIES=1
CLARIFT_PROVIDER_CIRCUIT_FAILURES=5
CLARIFT_PROVIDER_CIRCUIT_COOLDOWN_MS=60000

# Keyless free inference. Provider names and credentials remain server-only.
CLARIFT_FREE_INFERENCE_ROLLOUT_PERCENT=0
CLARIFT_FREE_OPENROUTER_MODEL=google/gemma-3-4b-it
CLARIFT_FREE_TOGETHER_MODEL=google/gemma-3n-E4B-it
CLARIFT_FREE_REFINEMENT_DAILY_UNITS=10
CLARIFT_FREE_REFINEMENT_MONTHLY_UNITS=200
CLARIFT_FREE_EVALUATION_DAILY_UNITS=5
CLARIFT_FREE_EVALUATION_MONTHLY_UNITS=100
CLARIFT_FREE_GLOBAL_CONCURRENCY=20
CLARIFT_FREE_REMOTE_DEADLINE_MS=30000
CLARIFT_OPENROUTER_DAILY_BUDGET_USD=4.00
CLARIFT_TOGETHER_DAILY_BUDGET_USD=0.50
CLARIFT_REMOTE_ADMISSION_BUDGET_USD=4.50
CLARIFT_OPENROUTER_INPUT_USD_PER_MILLION=0.05
CLARIFT_OPENROUTER_OUTPUT_USD_PER_MILLION=0.10
CLARIFT_TOGETHER_INPUT_USD_PER_MILLION=0.06
CLARIFT_TOGETHER_OUTPUT_USD_PER_MILLION=0.12
CLARIFT_PROVIDER_PRICING_EFFECTIVE_DATE=2026-08-14

# Quotas, rate limits, and provider allowlists. Tune before public launch.
FREE_DAILY_REQUEST_LIMIT=5
PRO_DAILY_REQUEST_LIMIT=200
PRO_MONTHLY_TOKEN_LIMIT=1000000
MAX_UPLOAD_SIZE_MB=10
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60
ADMIN_RATE_LIMIT_MAX_REQUESTS=20
OPENROUTER_ALLOWED_MODELS=openai/gpt-4o-mini,anthropic/claude-haiku-4.5,google/gemini-3.5-flash-lite,deepseek/deepseek-chat,qwen/qwen-2.5-coder
GEMINI_ALLOWED_MODELS=googleai/gemini-3.6-flash

# Required outside Firebase App Hosting when server-side tier enforcement is enabled.
# Point this to a Firebase service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: path to the Microsoft MarkItDown CLI for document conversion.
# Use `packaged` for the managed App Hosting runtime, or omit to use `markitdown` from PATH.
MARKITDOWN_COMMAND=
