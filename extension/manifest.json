{
  "manifest_version": 3,
  "minimum_chrome_version": "119",
  "name": "Clarift Prompt Refinery",
  "version": "2.3.1",
  "description": "Refine web prompts and searches, and carry conversations between chatbots with a portable context pill.",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "clipboardWrite"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "omnibox": { "keyword": "clarift" },
  "host_permissions": [
    "https://clarift--clarift-e4f6f.us-east4.hosted.app/*",
    "http://localhost:9002/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Clarift Prompt Refinery",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://copilot.microsoft.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://poe.com/*",
        "https://grok.com/*",
        "https://aistudio.google.com/*"
      ],
      "js": ["context-core.js", "context-capture.js", "context-history.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ]
}
