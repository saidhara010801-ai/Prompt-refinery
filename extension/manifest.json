{
  "manifest_version": 3,
  "name": "Clarift Prompt Refinery",
  "version": "2.1.0",
  "description": "Refine prompts inline on ChatGPT, Claude, Gemini, and other chatbot interfaces.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://clarift--clarift-e4f6f.us-east4.hosted.app/*",
    "http://localhost:9002/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Clarift Prompt Refinery",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://copilot.microsoft.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://poe.com/*",
        "https://grok.com/*",
        "https://aistudio.google.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
