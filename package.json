{
  "name": "clarift",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.4",
    "@genkit-ai/tools-common@1.41.0": {
      "body-parser": "1.20.6"
    },
    "@types/request": {
      "form-data": "2.5.6"
    },
    "ajv@8.20.0": {
      "fast-uri": "3.1.5"
    },
    "express@4.22.2": {
      "body-parser": "1.20.6"
    },
    "minimatch@9.0.9": {
      "brace-expansion": "2.1.4"
    },
    "postcss": {
      ".": "8.5.23",
      "nanoid": "3.3.18"
    },
    "protobufjs": "7.6.5",
    "websocket-driver": "0.7.5"
  },
  "scripts": {
    "dev": "next dev -p 9002",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "npm run build:developer && npm run package:extension && next build && npm run install:markitdown",
    "build:developer": "npm run build --workspace @clarift/sdk && npm run build --workspace @clarift/cli",
    "clarift": "npm run build:developer --silent && node packages/cli/dist/index.js",
    "clarift:mcp": "npm run build:developer --silent && node packages/cli/dist/index.js mcp --transport stdio",
    "package:extension": "node scripts/package-extension.mjs",
    "install:markitdown": "node scripts/install-markitdown-runtime.mjs",
    "start": "next start -p 9002",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run package:extension && tsx --test tests/*.test.ts",
    "check:production-env": "tsx scripts/check-production-env.ts",
    "migrate:project-memory": "tsx scripts/migrate-project-memory.ts",
    "migrate:personal-tenants": "tsx scripts/migrate-personal-tenants.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@genkit-ai/google-genai": "1.41.0",
    "@genkit-ai/next": "1.41.0",
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.5.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^11.9.1",
    "firebase-admin": "13.10.0",
    "framer-motion": "^11.2.10",
    "genkit": "1.41.0",
    "google-auth-library": "^10.6.2",
    "lucide-react": "^0.475.0",
    "next": "15.5.21",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "stripe": "^16.2.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "adm-zip": "0.5.17",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.21",
    "genkit-cli": "1.41.0",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
